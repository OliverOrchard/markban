{
  "permissions": {
    "allow": [
      "command(regex:dotnet (build|test|format)([^;&|`$]*))",
      "command(regex:markban (list|show|next|overview|health|help)([^;&|`$]*))",
      "command(regex:git (status|diff|log|rev-parse|branch --show-current)([^;&|`$]*))"
    ],
    "deny": [
      "command(regex:git (commit|push|checkout|switch|reset|clean)\\b.*)",
      "command(regex:markban (commit|move)\\b.*)"
    ]
  }
}
